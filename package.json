{
  "name": "qameta.io-playwright-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "run-pw-ui-mode": "cross-env ENV=dev npx playwright test --ui",
    "run-tests-headless": "cross-env ENV=dev npx playwright test",
    "run-tests-docker": "yarn clean-allure-folder && docker-compose -f docker-compose.local.yml up --build",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:generate:single": "allure generate ./allure-results --single-file --output ./allure-report",
    "allure:open": "allure open ./allure-report",
    "test:prod": "cross-env ENV=prod npx playwright test",
    "clean-allure-folder": "rimraf ./allure-results",
    "open-allure-report": "yarn allure:generate && yarn allure:open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@types/node": "^22.2.0",
    "allure-commandline": "2.34.1",
    "allure-playwright": "3.3.2",
    "dotenv": "16.4.5",
    "rimraf": "6.0.1"
  },
  "dependencies": {
    "cross-env": "7.0.3"
  },
  "packageManager": "yarn@4.5.3"
}
